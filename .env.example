# Default mode: preview the paywall and simulate the subscription flow without charges.
EXPO_PUBLIC_BILLING_MODE=demo

# To connect RevenueCat, set EXPO_PUBLIC_BILLING_MODE=revenuecat and fill the platform keys.
# Use the public SDK key from your RevenueCat project for the matching platform.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
# Optional: only needed if you configure RevenueCat Billing for web.
EXPO_PUBLIC_RC_WEB_KEY=
